# Local development only. Change these before any deployment.
POSTGRES_PASSWORD=local_admin_change_me
ACCOUNT_DB_PASSWORD=local_account_change_me
TUTOR_DB_PASSWORD=local_tutor_change_me
LEARNING_DB_PASSWORD=local_learning_change_me
PAYMENT_DB_PASSWORD=local_payment_change_me
NOTIFICATION_DB_PASSWORD=local_notification_change_me
ASSESSMENT_DB_PASSWORD=local_assessment_change_me
CARE_DB_PASSWORD=local_care_change_me
AI_DB_PASSWORD=local_ai_change_me
# Shared HS256 key for access tokens, at least 32 bytes. Same value for every service.
JWT_SECRET=local_jwt_secret_change_me_min_32_bytes
# Mock login (mục 3): identity seeds 6 demo accounts (incl. support@demo.giasu.vn) with this password. Leave empty to disable.
DEMO_PASSWORD=Demo@12345
# "demo" loads demo tutor profiles / availability / plans (db/demo migrations). Empty to disable.
SPRING_PROFILES_ACTIVE=demo
# Host port for PostgreSQL. Change if 5432 is taken (e.g. a local PostgreSQL install).
POSTGRES_HOST_PORT=5432
